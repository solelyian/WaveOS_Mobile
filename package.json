{
  "name": "waveos-proto",
  "private": true,
  "version": "0.2.0",
  "description": "WaveOS mobile — calque fidèle de la maquette React (TypeScript + C/C++ WASM)",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "tokens": "node tools/gen-tokens.mjs",
    "wasm": "sh tools/build-wasm.sh",
    "dev": "npm run tokens && vite",
    "build": "npm run tokens && tsc --noEmit && vite build",
    "preview": "vite preview",
    "dist:win": "npm run build && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "lucide-static": "^1.52.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "ai.nyne.waveos",
    "productName": "WaveOS",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "WaveOS-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native-web": "^0.21.4"
  }
}
